# Copy to .env (gitignored) and fill in. Real environment variables override these.

# Facebook Messenger (see watcher/notifiers/messenger.py for how to get them)
MESSENGER_PAGE_TOKEN=
MESSENGER_RECIPIENT_ID=
# Tag to retry with once Meta's 24-hour window has closed (needs App Review); empty = no retry.
# MESSENGER_TAG=ACCOUNT_UPDATE
# How often `watcher web` checks for your messages (each one starts a refresh); 0 = never.
# MESSENGER_POLL_SECONDS=30
# MESSENGER_API_VERSION=v23.0
